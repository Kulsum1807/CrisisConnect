# Server
NODE_ENV=development
PORT=5000

# MongoDB
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/crisisconnect?appName=Cluster0

# JWT Secrets (use strong, unique values in production)
JWT_ACCESS_SECRET=your_access_secret_here
JWT_REFRESH_SECRET=your_refresh_secret_here

# Token TTLs
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d

# Client URL (for CORS and cookies)
CLIENT_URL=http://localhost:5173

# Cookie settings (set secure=true and samesite=none for production with HTTPS)
COOKIE_SAMESITE=lax
COOKIE_SECURE=false

# Alert configuration
ALERT_RADIUS_KM=5
CLAIM_TIMEOUT_SEC=60

# OpenStreetMap Overpass API
OVERPASS_URL=https://overpass.openstreetmap.fr/api/interpreter

